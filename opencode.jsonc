{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "docs/*", "effect": "allow" },
    { "action": "read", "resource": "pdf/*", "effect": "allow" },
    { "action": "read", "resource": "*.pdf", "effect": "allow" },
    { "action": "edit", "resource": "docs/*", "effect": "allow" },
    { "action": "edit", "resource": "pdf/*", "effect": "deny" },
    { "action": "edit", "resource": "*.pdf", "effect": "deny" },
    { "action": "glob", "resource": "*docs*", "effect": "deny" },
    { "action": "glob", "resource": "*pdf*", "effect": "deny" },
    { "action": "glob", "resource": "*.pdf", "effect": "deny" }
  ],
  // Cap how much of each tool result is kept (lines and bytes).
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 16384
  },
  // Summarize older conversation sooner and keep a smaller recent tail.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": "25%"
  },
  // Downscale large images before they are sent to the model.
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1280,
      "max_height": 1280,
      "max_base64_bytes": 2097152
    }
  },
  "watcher": {
    "ignore": ["docs/**", "pdf/**"]
  }
}
