{
  "name": "preseter",
  "version": "1.0.0",
  "description": "Aplicativo de performance ao vivo estilo Mainstage e Gig Performer - controle de presets MIDI e carregamento de VST",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "dev": "npm run build:main && concurrently \"npm:dev:renderer\" \"npm:dev:main:watch\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main:watch": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "node scripts/dev-electron.js",
    "package": "electron-builder build",
    "preview": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "vst",
    "midi",
    "mainstage",
    "gig-performer",
    "live-performance",
    "music"
  ],
  "author": "Preseter Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.60",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.preseter.app",
    "productName": "Preseter",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!docs/**/*",
      "!presets/**/*",
      "!release/**/*",
      "!scripts/**/*",
      "!src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "engine/build/PreseterEngine_artefacts/Release/PreseterEngine.exe",
          "to": "engine/PreseterEngine.exe"
        },
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "engine/build/PreseterEngine_artefacts/Release/PreseterEngine",
          "to": "engine/PreseterEngine"
        }
      ]
    },
    "mac": {
      "extraResources": [
        {
          "from": "engine/build/PreseterEngine_artefacts/Release/PreseterEngine",
          "to": "engine/PreseterEngine"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
